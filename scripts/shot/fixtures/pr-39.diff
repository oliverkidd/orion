-    list.sort_by(|a, b| a.is_draft.cmp(&b.is_draft));
+/// Sink the drafts below everything else, keeping the order within
+/// each half: a stable sort, so the cursor never swaps rows.
+pub fn drafts_last(list: &mut [Pr]) {
+    list.sort_by_key(|pr| pr.is_draft);
 }
